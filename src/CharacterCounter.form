<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="CharacterCounter">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="12">
    <margin top="10" left="45" bottom="20" right="45"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="d5585">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <verticalScrollBarPolicy value="22"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="6b880" class="javax.swing.JTextArea" binding="messageTextArea">
            <constraints/>
            <properties>
              <columns value="25"/>
              <lineWrap value="true"/>
              <rows value="8"/>
              <wrapStyleWord value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="f1fd7" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Enter Character:"/>
        </properties>
      </component>
      <component id="c7dfe" class="javax.swing.JTextField" binding="characterTextField">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="50" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <columns value="3"/>
        </properties>
      </component>
      <component id="9c399" class="javax.swing.JButton" binding="countButton">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Count"/>
        </properties>
      </component>
      <component id="3cabd" class="javax.swing.JLabel" binding="count">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Count:"/>
        </properties>
      </component>
      <component id="8da6a" class="javax.swing.JLabel" binding="countLabel">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="0"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
