<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="NumberCounter">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="25" vgap="40">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="384"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="a74cb" class="javax.swing.JLabel" binding="countLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="2" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="0"/>
        </properties>
      </component>
      <component id="9f226" class="javax.swing.JButton" binding="increaseButton">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Increase"/>
        </properties>
      </component>
      <component id="17007" class="javax.swing.JButton" binding="decreaseButton">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="5" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <alignmentY value="0.5"/>
          <rolloverEnabled value="false"/>
          <text value="Decrease"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
